---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { ArrowUpRight } from 'lucide-astro';
import { blogGuides } from '../data/blogGuides';
import { pageUrl, siteConfig } from '../data/siteConfig';
import { blogPosts, blogPath, type BlogPost } from '../data/blog';
import { getGuideMeta, readingMinutes } from '../data/blogMeta';
import { locales, type Locale } from '../data/i18n';
import '../styles/blog.css';
interface Props { lang: Locale; post?: BlogPost; }
const { lang, post } = Astro.props;
const alt: Locale = lang === 'tr' ? 'en' : 'tr';
const article = post?.[lang];
const home = locales[lang].homePath;
const canonicalPath = post ? blogPath(lang, post) : `${home}/blog`;
const alternatePath = post ? blogPath(alt, post) : `${locales[alt].homePath}/blog`;
const title = article?.title ?? (lang === 'tr' ? 'Dijitalde doğru kararlar.' : 'Better decisions for your business online.');
const description = article?.summary ?? (lang === 'tr' ? 'Web sitesi, SEO, Google Haritalar ve dijitalleşme hakkında işletme sahipleri için pratik rehberler.' : 'Practical guides to websites, SEO, Google Maps and digitalisation for business owners.');
const url = pageUrl(canonicalPath);
const schema = [
  ...(article ? [{ '@context': 'https://schema.org', '@type': 'Article', headline: title, description, inLanguage: lang, mainEntityOfPage: url, publisher: { '@type': 'Organization', name: 'Mifer Digital', url: siteConfig.url } }] : []),
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: lang === 'tr' ? 'Ana sayfa' : 'Home', item: pageUrl(home) },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: pageUrl(`${home}/blog`) },
    ...(article ? [{ '@type': 'ListItem', position: 3, name: title, item: url }] : [])
  ] }
];
---
<BaseLayout lang={lang} title={`${article ? title : 'Blog'} | Mifer Digital`} description={description} canonicalPath={canonicalPath} alternatePath={alternatePath} article={Boolean(article)}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  <Header lang={lang} alternatePath={alternatePath} />
  <main class="blog-main container-shell">
    <a class="blog-back" data-nav-link data-section-link={article ? undefined : 'approach-start'} href={article ? `${home}/blog` : home}>← {article ? (lang === 'tr' ? 'Bloga dön' : 'Back to the blog') : (lang === 'tr' ? 'Yaklaşımımıza dön' : 'Back to our approach')}</a>
    <header class="blog-heading">
      <p class="blog-eyebrow">MIFER DIGITAL / BLOG</p>
      <h1>{title}</h1>
      <p class="blog-summary">{description}</p>
    </header>
    {article ? (
      <article class="blog-article" aria-label={article.title}>
        {article.sections.length > 3 && <nav class="blog-toc" aria-label={lang === 'tr' ? 'Bu yazıda' : 'In this guide'}><strong>{lang === 'tr' ? 'Bu yazıda' : 'In this guide'}</strong><ul>{article.sections.map((section, index) => <li><a href={`#section-${index}`}>{section.title}</a></li>)}</ul></nav>}
        {article.sections.map((section, index) => <section id={`section-${index}`}><h2>{section.title}</h2>{section.paragraphs.map(text => <p>{text}</p>)}
          {section.table && <div class="blog-table-scroll" tabindex="0" role="region" aria-label={section.title}><table><thead><tr>{section.table.headers.map(h => <th scope="col">{h}</th>)}</tr></thead><tbody>{section.table.rows.map(row => <tr>{row.map((cell, i) => i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>)}</tbody></table></div>}
          {section.source && <aside class="blog-source"><span>{lang === 'tr' ? 'Kaynak' : 'Source'}</span><a href={section.source.url} target="_blank" rel="noopener noreferrer">{section.source.label} ↗</a></aside>}
        </section>)}
      </article>
    ) : (
      <>
        <div class="blog-index-toolbar" aria-label={lang === 'tr' ? 'Blog açıklaması' : 'Blog overview'}>
          <p>{lang === 'tr' ? 'İşletme sahipleri için sade rehberler. Veri veya resmi bir kural kullandığımız yerde kaynağı yazının içinde açıkça gösteriyoruz.' : 'Clear guides for business owners. When we rely on data or official guidance, the source is shown inside the article.'}</p>
          <span>{blogGuides.length} {lang === 'tr' ? 'rehber' : 'guides'}</span>
        </div>
        <div class="blog-grid blog-grid-editorial">
          {blogGuides.map((entry, index) => {
            const meta = getGuideMeta(index, lang);
            const minutes = readingMinutes(entry[lang].sections.flatMap(section => section.paragraphs));
            return <article class:list={["blog-card", "blog-card-editorial", index === 0 && "blog-card-featured"]}>
              <a class="blog-card-media" data-nav-link data-prefetch-link data-astro-prefetch href={blogPath(lang, entry)} aria-hidden="true" tabindex="-1">
                <img src={meta.art} alt="" width="1200" height="720" loading={index < 2 ? 'eager' : 'lazy'} decoding="async" />
              </a>
              <div class="blog-card-body">
                <div class="blog-card-meta"><span>{meta.category}</span><span>{minutes} {lang === 'tr' ? 'dk okuma' : 'min read'}</span></div>
                <h2><a data-nav-link data-prefetch-link data-astro-prefetch href={blogPath(lang, entry)}>{entry[lang].title}<ArrowUpRight size={22} aria-hidden="true" /></a></h2>
                <p>{entry[lang].summary}</p>
              </div>
            </article>;
          })}
        </div>
      </>
    )}
    {!article && <section class="blog-process"><h2>{lang === 'tr' ? 'Mifer ile çalışma süreci' : 'Working with Mifer'}</h2><div>{blogPosts.map(entry => <a data-nav-link data-astro-prefetch href={blogPath(lang, entry)}>{entry[lang].title}<ArrowUpRight size={20} aria-hidden="true" /></a>)}</div></section>}
    <aside class="blog-contact">
      <h2>{lang === 'tr' ? 'Sizin projenizi konuşalım.' : 'Let’s talk about your project.'}</h2>
      <a data-nav-link data-section-link={article?.target === 'packages' ? undefined : article?.target ?? 'contact'} href={article?.target === 'packages' ? `${home}#paketler` : home}>{article?.cta ?? (lang === 'tr' ? 'Mifer ile iletişime geçin' : 'Get in touch with Mifer')} <ArrowUpRight size={20} aria-hidden="true" /></a>
    </aside>
  </main>
  <Footer lang={lang} alternatePath={alternatePath} />
</BaseLayout>
