---
import { ArrowLeft } from 'lucide-astro';
import type { Locale } from '../data/i18n';
interface Props { lang: Locale; }
const { lang } = Astro.props;
const label = lang === 'tr' ? 'Mifer’e dön' : 'Back to Mifer';
---
<a class="mifer-demo-return" data-mifer-demo-return href={`/${lang}#work`} aria-label={lang === 'tr' ? 'Mifer Digital çalışmalarına dön' : 'Back to Mifer Digital’s work'}>
  <ArrowLeft size={16} strokeWidth={1.7} aria-hidden="true" />
  <span>{label}</span>
</a>
<style>
  @font-face { font-family: 'Mifer Navigation'; src: url('/fonts/inter-variable.woff2') format('woff2'); font-weight: 100 900; font-display: swap; }
  .mifer-demo-return {
    position: fixed; z-index: 120;
    left: max(18px, env(safe-area-inset-left)); bottom: max(18px, env(safe-area-inset-bottom));
    display: inline-flex; align-items: center; justify-content: center; gap: 9px;
    min-height: 44px; padding: 0 14px; box-sizing: border-box;
    border: 1px solid #bdc4c0; border-radius: 4px;
    background: #fafbf8; color: #24362e !important;
    box-shadow: 0 2px 12px #00000012;
    font: 500 14px/1.3 'Mifer Navigation', Arial, sans-serif;
    text-decoration: none; letter-spacing: -.015em; white-space: nowrap;
    -webkit-tap-highlight-color: transparent;
    transition: color .2s, background-color .2s, border-color .2s;
  }
  .mifer-demo-return svg { flex: none; transition: transform .2s; }
  .mifer-demo-return:hover { background: #24362e; color: #fff !important; border-color: #24362e; }
  .mifer-demo-return:hover svg { transform: translateX(-3px); }
  .mifer-demo-return:active { background: #e2e8e3; color: #24362e !important; }
  .mifer-demo-return:focus-visible { outline: 3px solid #698bba; outline-offset: 4px; }
  :global(html:has(.mifer-demo-return)) { scroll-padding-bottom: calc(90px + env(safe-area-inset-bottom)); }
  @media (max-width: 760px) {
    .mifer-demo-return { left: max(12px, env(safe-area-inset-left)); bottom: calc(10px + env(safe-area-inset-bottom)); padding-inline: 11px; gap: 7px; }
  }
  @media (prefers-reduced-motion: reduce) { .mifer-demo-return, .mifer-demo-return svg { transition: none; } }
</style>
