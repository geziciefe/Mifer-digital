---
import { Menu, X } from 'lucide-astro';
import Logo from './Logo.astro';
import ContactPanel from './ContactPanel.astro';
import { content, locales, type Locale } from '../data/i18n';

interface Props {
  lang: Locale;
  alternatePath?: string;
  revealAfterScroll?: boolean;
  keepVisibleOnMobile?: boolean;
}
const { lang, alternatePath = locales[lang === 'tr' ? 'en' : 'tr'].homePath, revealAfterScroll = false, keepVisibleOnMobile = false } = Astro.props;
const t = content[lang];
const configuredHome = locales[lang].homePath;
const isRootTurkishHome = lang === 'tr' && Astro.url.pathname === '/';
const home = isRootTurkishHome ? '/' : configuredHome;
const work = locales[lang].workPath;
const navigation = [
  { label: t.nav.about, href: home, section: 'about' },
  { label: t.nav.services, href: home, section: 'process' },
  { label: t.nav.work, href: work, section: '' },
  { label: lang === 'tr' ? 'Fiyatlar' : 'Pricing', href: `${home}#paketler`, section: '' },
  { label: 'Blog', href: `${configuredHome}/blog`, section: '' }
];
---
<header class:list={["site-header", revealAfterScroll && "site-header-reveal"]} data-site-header data-keep-visible-mobile={keepVisibleOnMobile || undefined}>
  <div class="header-inner">
    <nav class="desktop-nav nav-left" aria-label="Primary navigation">
      {navigation.map(item => <a data-nav-link data-section-link={item.section || undefined} data-prefetch-link={!item.section || undefined} data-astro-prefetch={!item.section || undefined} href={item.href}>{item.label}</a>)}
    </nav>

    <a href={home} class="brand-lockup-center" data-nav-link data-prefetch-link data-astro-prefetch aria-label={lang === 'tr' ? 'Mifer Digital ana sayfa' : 'Mifer Digital home page'}>
      <span class="brand-lockup-visual">
        <Logo compact class="header-brand-mark" />
        <span class="header-brand-name">mifer</span>
        <span class="header-brand-sub">digital</span>
      </span>
    </a>

    <div class="header-actions">
      <a
        class="lang-switch-round"
        data-nav-link
        data-prefetch-link data-astro-prefetch
        data-lang-switch
        data-lang={lang}
        href={alternatePath}
        hreflang={lang === 'tr' ? 'en' : 'tr'}
        aria-label={`${locales[lang].switchLabel} diline geç`}
        title={`${locales[lang].switchLabel} diline geç`}
      >
        <span class="lang-code">{locales[lang].label}</span>
      </a>
      <button class="header-contact" type="button" data-contact-open>{t.nav.contact}</button>
      <button id="menu-toggle" class="menu-toggle" type="button" aria-controls="mobile-menu" aria-expanded="false" aria-label={t.nav.menu}>
        <Menu id="menu-open" size={22} strokeWidth={1.6} />
        <X id="menu-close" class="hidden" size={22} strokeWidth={1.6} />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu hidden">
    <nav class="container-shell mobile-nav" aria-label="Mobile navigation">
      {navigation.map(item => <a data-nav-link data-section-link={item.section || undefined} data-prefetch-link={!item.section || undefined} data-astro-prefetch={!item.section || undefined} href={item.href}>{item.label}</a>)}
      <button type="button" data-contact-open>{t.nav.contact}</button>
    </nav>
  </div>
</header>
<ContactPanel lang={lang} />
