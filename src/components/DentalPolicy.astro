---
import {ArrowLeft} from 'lucide-astro';
import DentalFrame from './DentalFrame.astro';
import {dentalCopy,dentalPaths,type DentalLang} from '../data/dental';
interface Props{lang:DentalLang;kind:'privacy'|'cookies'|'legal';}
const {lang,kind}=Astro.props;const c=dentalCopy[lang];const other=lang==='tr'?'en':'tr';
const slugs={privacy:{tr:'kvkk',en:'privacy'},cookies:{tr:'cerez-politikasi',en:'cookie-policy'},legal:{tr:'yasal-bilgilendirme',en:'legal'}};
const title=c[kind];
const text={
 privacy:{tr:[['Demo formu ve kişisel veriler','Bu form yalnızca arayüz deneyimini gösterir. Yazdığınız bilgiler sayfa içinde işlenir; form gönderimi, kalıcı kayıt veya üçüncü tarafa aktarım yapılmaz. Gönder düğmesi alanları temizler ve demo sonucunu gösterir. Gerçek kişisel veya sağlık bilgilerinizi girmeyin.'],['Aydınlatma ve açık rıza','Formdaki kutu, bu bilgilendirmeyi okuduğunuzu belirtir; pazarlama izni veya sağlık verisi işlemeye yönelik açık rıza değildir. Aydınlatma ile açık rıza farklı işlemlerdir.'],['Gerçek klinik kullanımı','Canlı bir randevu sistemi kurulmadan önce veri sorumlusunun unvanı, iletişim bilgileri, amaçlar, hukuki sebepler, alıcı grupları, saklama süreleri ve ilgili kişi hakları gerçek veri akışına göre belirlenmelidir. Bu demo metni bir kliniğin hukuki aydınlatma yükümlülüğünü tek başına karşılamaz.'],['Harita ve barındırma','Haritayı açtığınızda Google ile bağlantı kurulur; IP adresi gibi teknik veriler bu sağlayıcıya iletilebilir. Siteyi sunan altyapının güvenlik ve erişim günlükleri kendi koşullarına tabidir.']],en:[['Demo form and personal information','This form demonstrates the interface only. Entries are handled within the page: they are not submitted, stored persistently or transferred to a third party by the form. Submitting clears the fields and shows a demo result. Do not enter actual personal or medical information.'],['Notice and consent','The checkbox acknowledges that you have read this notice. It is not marketing permission or explicit consent to process health data. Providing a notice and obtaining consent are separate actions.'],['Use by an actual clinic','Before connecting a live booking system, identify the data controller, contact details, purposes, legal bases, recipients, retention periods and individual rights based on the actual data flow. This demo notice does not by itself meet a clinic’s legal obligations.'],['Maps and hosting','Opening the map connects to Google and may transmit technical information such as your IP address. Security and access logs maintained by the hosting infrastructure are subject to that provider’s terms.']]},
 cookies:{tr:[['Bu demoda çerez kullanımı','Dental demo kodu analiz, reklam veya tercih çerezi oluşturmaz; tarayıcı depolamasına form bilgisi yazmaz. Siteyi sunan barındırma veya erişim altyapısı kendi teknik mekanizmalarını kullanabilir.'],['Üçüncü taraf harita','Google Haritalar otomatik yüklenmez. Haritayı açmayı seçerseniz Google’ın çerez ve veri işleme koşulları uygulanabilir. Haritayı açmadan da sayfayı ve randevu demosunu kullanabilirsiniz.'],['Gerçek yayına geçerken','Analitik, reklam veya başka üçüncü taraf hizmetleri eklenirse çerez envanteri ve gerekli izin mekanizması ayrıca hazırlanmalıdır.']],en:[['Cookies in this demo','The dental demo code does not set analytics, advertising or preference cookies, and does not write form information to browser storage. Hosting or access infrastructure may use its own technical mechanisms.'],['Third-party map','Google Maps does not load automatically. If you choose to open it, Google’s cookie and data-processing terms may apply. You can use the page and appointment demo without opening the map.'],['Before a real launch','Adding analytics, advertising or other third-party services requires an updated cookie inventory and an appropriate consent mechanism.']]},
 legal:{tr:[['Kurgusal klinik konsepti','Avelis ve Dt. Defne Aral, Mifer Digital tarafından bu web tasarımı örneği için oluşturulmuş kurgusal kimliklerdir. Klinik görselleri yapay zekâ ile üretilmiştir. Gerçek bir sağlık kuruluşunu veya hekimi temsil etmez. Konum ve çalışma saatleri örnektir.'],['Tıbbi bilgilendirme','Tedavi metinleri genel bilgilendirme niteliğindedir. Tanı koymaz, kişisel tedavi önermez ve sonuç garantisi vermez. Gerçek bir klinikte yayımlanmadan önce yetkili sağlık meslek mensubu tarafından gözden geçirilmelidir.'],['İletişim ve editör','Konseptin editoryal ve tasarım sorumlusu Mifer Digital’dir. Sorularınız için iletisim@miferdigital.com adresine ulaşabilirsiniz. Bu adres klinik randevu veya sağlık danışmanlığı hattı değildir.']],en:[['Fictional clinic concept','Avelis and Dt. Defne Aral are fictional identities created by Mifer Digital for this website concept. Clinic imagery is AI-generated. They do not represent an actual healthcare provider or dentist. Location and opening hours are illustrative.'],['Medical information','Treatment content is general information, not a diagnosis, personal treatment recommendation or guarantee of results. A qualified healthcare professional must review it before publication for an actual clinic.'],['Contact and editor','Mifer Digital is responsible for the concept’s editorial presentation and design. Contact iletisim@miferdigital.com with questions about the concept. This is not a clinical booking or medical advice service.']]}
};
---
<DentalFrame lang={lang} title={`${title} — Avelis`} path={`${dentalPaths[lang]}/${slugs[kind][lang]}`} alternatePath={`${dentalPaths[other]}/${slugs[kind][other]}`}><main id="main" class="av-wrap av-article"><a class="av-text-link" href={dentalPaths[lang]}><ArrowLeft size={18}/>Avelis</a><p class="av-eyebrow">AVELIS · DEMO</p><h1>{title}</h1>{text[kind][lang].map(([heading,body])=><section><h2>{heading}</h2><p>{body}</p></section>)}<p class="av-article-source">{c.updated}</p></main></DentalFrame>
