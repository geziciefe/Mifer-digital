---
import { ArrowUpRight, ArrowDown, Plus, Phone, MapPin, ArrowRight, ChevronDown } from 'lucide-astro';
import DentalFrame from './DentalFrame.astro';
import { dentalCopy, dentalPaths, treatments, type DentalLang } from '../data/dental';
interface Props {lang:DentalLang;}
const {lang}=Astro.props; const c=dentalCopy[lang]; const home=dentalPaths[lang];
const treatmentUrl=(t:typeof treatments[number])=>`${home}/${lang==='tr'?'tedaviler':'treatments'}/${lang==='tr'?t.slug:t.enSlug}`;
---
<DentalFrame lang={lang}>
 <main id="main">
  <section class="av-hero" aria-labelledby="hero-title">
   <div class="av-hero-copy"><p class="av-hero-context"><span class="av-location"><MapPin size={15} strokeWidth={1.5}/>{c.location}</span><span>{c.eyebrow}</span></p><h1 id="hero-title">{c.heroA}<br/><em>{c.heroB}</em></h1><p class="av-hero-lead">{c.heroText}</p><a class="av-button av-button-mint" href="#appointment">{c.book}<ArrowUpRight size={20}/></a><a class="av-explore" href="#approach"><ArrowDown size={16}/>{c.explore}</a></div>
   <figure class="av-hero-image"><img src="/demos/mifer-smile/clinic-hero.webp" width="1672" height="941" fetchpriority="high" alt={lang==='tr'?'Gün ışığı alan Avelis konsept tedavi odası':'Daylit treatment room in the Avelis clinic concept'}/><figcaption><span>AVELIS / NİŞANTAŞI</span><span>{lang==='tr'?'Size ayrılmış bir alan.':'A space set aside for you.'}</span></figcaption></figure>
   <div class="av-hero-strip"><span>{c.heroBottom}</span><span>{lang==='tr'?'Önce dinleriz.':'We listen first.'}</span></div>
  </section>
  <section class="av-wrap av-intro av-space" id="approach"><p class="av-eyebrow" data-av-reveal>{c.introLabel}</p><div data-av-reveal><h2>{c.introA}<span class="av-heading-line">{c.introB}</span></h2><div class="av-intro-body"><p>{c.introText}</p><p class="av-intro-note">{c.introNote}</p></div></div></section>
  <section class="av-treatments" id="treatments"><div class="av-wrap av-treatment-grid"><header data-av-reveal><p class="av-eyebrow">{c.treatLabel}</p><h2>{c.treatA}<span class="av-heading-line">{c.treatB}</span></h2><p>{c.treatText}</p><figure class="av-treatment-detail"><img src="/demos/mifer-smile/digital-scanner.webp" width="960" height="640" loading="lazy" decoding="async" alt={c.detailAlt}/><figcaption>{c.detail}</figcaption></figure></header><div class="av-treatment-list">{treatments.map((t)=><a href={treatmentUrl(t)} class="av-treatment-row" data-av-reveal><div><h3>{t[lang]}</h3><p>{t.summary[lang]}</p></div><span aria-hidden="true"><ArrowUpRight size={23}/></span></a>)}</div></div></section>
  <section class="av-wrap av-doctor av-space" id="dentist"><figure data-av-reveal><img src="/demos/mifer-smile/doctor.webp" width="1024" height="1536" loading="lazy" alt={lang==='tr'?'Kurgusal diş hekimi Defne Aral’ın temsili portresi':'Illustrative portrait of fictional dentist Defne Aral'}/><figcaption><span>{c.doctorName}</span><span>{c.doctorRole}</span></figcaption></figure><div class="av-doctor-copy" data-av-reveal><p class="av-eyebrow">{c.teamLabel}</p><h2>{c.teamTitle}</h2><p>{c.doctorBio}</p><dl><div><dt>{c.focus}</dt><dd>{c.focusText}</dd></div><div><dt>{c.careApproach}</dt><dd>{c.careApproachText}</dd></div></dl><details><summary>{c.bioLabel}<Plus size={18}/></summary><div class="av-profile-content"><h3>{c.profileHeading}</h3><p>{c.profileText}</p><p class="av-profile-note">{c.bioText}</p></div></details></div></section>
  <section class="av-clinic" id="clinic"><div class="av-wrap av-section-heading" data-av-reveal><div><p class="av-eyebrow">{c.clinicLabel}</p><h2>{c.clinicA}<span class="av-heading-line">{c.clinicB}</span></h2></div><p>{c.clinicText}</p></div><div class="av-gallery"><figure class="av-gallery-main" data-av-reveal><img src="/demos/mifer-smile/waiting-room.webp" width="1536" height="1024" loading="lazy" alt={lang==='tr'?'Lacivert oturma alanı, doğal ahşap ve açık taş yüzeylerle Avelis konsept bekleme salonu':'Avelis concept waiting room with navy seating, natural oak and light stone'}/><figcaption><span>{c.lounge}</span><span>AVELIS</span></figcaption></figure><figure class="av-gallery-side" data-av-reveal><img src="/demos/mifer-smile/clinic-hero.webp" width="1672" height="941" loading="lazy" alt={c.room}/><figcaption>{c.room}</figcaption></figure></div></section>
  <section class="av-journey"><div class="av-wrap"><div class="av-section-heading" data-av-reveal><p class="av-eyebrow">{c.journeyLabel}</p><h2>{c.journeyTitle}</h2></div><ol>{c.steps.map(([title,text],i)=><li data-av-reveal><span>0{i+1}</span><h3>{title}</h3><p>{text}</p></li>)}</ol></div></section>
  <section class="av-wrap av-journal av-space" id="journal"><div class="av-section-heading" data-av-reveal><div><p class="av-eyebrow">{c.journalLabel}</p><h2>{c.journalTitle}</h2></div><p>{c.journalText}</p></div><div class="av-journal-list">{[treatments[1],treatments[4],treatments[5]].map((t,i)=><a href={treatmentUrl(t)} data-av-reveal><span>{lang==='tr'?'AĞIZ SAĞLIĞI':'ORAL HEALTH'} / 0{i+1}</span><h3>{lang==='tr'?[ 'Ortodontik değerlendirmede neler konuşulur?','Diş eti sağlığınızı anlamak','Çocuklarda ilk bakım alışkanlıkları'][i]:['What happens at an orthodontic assessment?','Understanding your gum health','Building dental habits in childhood'][i]}</h3><span class="av-text-link">{lang==='tr'?'Yazıyı okuyun':'Read the article'}<ArrowUpRight size={19}/></span></a>)}</div></section>
  <section class="av-contact" id="contact"><div class="av-wrap av-contact-grid"><div class="av-contact-info" data-av-reveal><p class="av-eyebrow">{c.contactLabel}</p><h2>{c.contactTitle}</h2><address>{c.address.split('\n').map(line=><span>{line}</span>)}</address><small>{c.addressNote}</small><div class="av-contact-links"><button data-av-contact><Phone size={17}/>{c.call}<ArrowUpRight size={17}/></button><button data-av-contact>WhatsApp<ArrowUpRight size={17}/></button></div><div class="av-hours"><h3>{c.hours}</h3><p><span>{c.week}</span><span>09.00 – 19.00</span></p><p><span>{c.sat}</span><span>09.00 – 15.00</span></p><p><span>{c.sun}</span><span>{c.closed}</span></p></div><details class="av-transport"><summary>{c.transport}<Plus size={18}/></summary><p>{c.transportText}</p></details></div><div class="av-appointment" id="appointment" data-av-reveal><p class="av-eyebrow">{c.book}</p><p>{c.contactText}</p><form data-av-form data-success={c.success} inert><label>{c.name}<input name="name" autocomplete="name" required maxlength="80" placeholder={lang==='tr'?'Ad soyad':'Full name'}/></label><label>{c.phone}<input name="phone" inputmode="tel" type="tel" autocomplete="tel" required pattern="[+]?[0-9 ]{7,20}" placeholder="+90 5XX XXX XX XX"/></label><label>{c.department}<span class="av-select"><select name="department"><option value="general">{c.choose}</option>{treatments.map(t=><option value={t.slug}>{t[lang]}</option>)}</select><ChevronDown size={18} aria-hidden="true"/></span></label><p class="av-form-note">{c.formNote}</p><a class="av-privacy-link" href={`${home}/${lang==='tr'?'kvkk':'privacy'}`} target="_blank" rel="noopener">{c.noticeLink}<ArrowUpRight size={14}/></a><label class="av-checkbox"><input type="checkbox" name="notice_read" required/><span>{c.notice}</span></label><button class="av-button" type="submit">{c.send}<ArrowRight size={18}/></button><output hidden tabindex="-1" role="status" aria-live="polite"></output></form><noscript>{lang==='tr'?'Demo formu için JavaScript gereklidir.':'JavaScript is needed to try the demo form.'}</noscript></div></div><div class="av-map av-wrap"><div class="av-map-cover"><MapPin size={29} strokeWidth={1.3}/><h3>Nişantaşı, İstanbul</h3><button class="av-text-link" data-av-map>{c.map}<ArrowUpRight size={18}/></button><small>{c.mapNote}</small></div><iframe title={c.mapTitle} data-map-frame hidden loading="lazy" referrerpolicy="no-referrer" allowfullscreen></iframe></div></section>
 </main>
</DentalFrame>
