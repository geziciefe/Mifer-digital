---
import SalonLayout from '../layouts/SalonLayout.astro';
import { siteConfig } from '../data/siteConfig';

interface Props { lang: 'tr' | 'en'; }
const { lang } = Astro.props;

const copy = {
  tr: {
    metaTitle: 'Veyra Atelier | İstanbul Hair Atelier',
    metaDescription: 'Veyra Atelier; kesim, renklendirme ve kişiye özel saç bakımı için hazırlanmış premium salon deneyimi.',
    path: '/tr/kuafor-demo',
    altPath: '/en/hair-salon-demo',
    menu: 'Menü',
    close: 'Kapat',
    book: 'RANDEVU AL',
    brand: 'VEYRA ATELIER',
    brandLocation: 'İSTANBUL',
    menuItems: [['Ana sayfa', '#home'], ['Hikâyemiz', '#about'], ['Hizmetler', '#services'], ['Salon', '#salon'], ['Randevu', '#booking']],
    scroll: 'Keşfetmek için kaydır',
    award: 'SAÇINIZIN EN İYİ HALİ',
    intro: 'İstanbul’un ritmini, kişisel stilinizle buluşturan yeni nesil kuaför deneyimi.',
    introNote: 'Kesimden renge, her detay yüzünüze, yaşamınıza ve saçınızın gerçek ihtiyacına göre tasarlanır.',
