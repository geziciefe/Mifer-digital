---
import { ArrowUpRight, Instagram, Mail } from 'lucide-astro';
import Wordmark from './Wordmark.astro';
import { contactLinks, siteConfig } from '../data/siteConfig';
import { content, locales, type Locale } from '../data/i18n';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = content[lang];
---
<footer class="footer-shell">
  <div class="container-shell footer-main-row">
    <div class="footer-wordmark" aria-hidden="true">
      <Wordmark variant="footer-ghost" />
    </div>

    <div class="footer-contact">
      <a class="footer-mail" href={contactLinks.email}><Mail size={15} />{siteConfig.email}<ArrowUpRight size={15} /></a>
      <div class="footer-socials" aria-label="Social media">
        {contactLinks.whatsapp ? (
          <a class="footer-social footer-social-whatsapp" href={contactLinks.whatsapp} target="_blank" rel="noreferrer" aria-label="WhatsApp">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.87 1.21 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.19 1.87.12.57-.08 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35ZM12.04 2a9.84 9.84 0 0 0-8.4 14.95L2 22l5.2-1.62A9.92 9.92 0 1 0 12.04 2Zm0 17.99a8.1 8.1 0 0 1-4.13-1.13l-.3-.18-3.08.96.98-3-.2-.31A8.1 8.1 0 1 1 12.04 20Z"/></svg>
          </a>
        ) : <span class="footer-social is-unavailable" aria-label="WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.87 1.21 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.19 1.87.12.57-.08 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35ZM12.04 2a9.84 9.84 0 0 0-8.4 14.95L2 22l5.2-1.62A9.92 9.92 0 1 0 12.04 2Zm0 17.99a8.1 8.1 0 0 1-4.13-1.13l-.3-.18-3.08.96.98-3-.2-.31A8.1 8.1 0 1 1 12.04 20Z"/></svg></span>}
        {contactLinks.instagram ? (
          <a class="footer-social footer-social-instagram" href={contactLinks.instagram} target="_blank" rel="noreferrer" aria-label="Instagram"><Instagram size={16} /></a>
        ) : <span class="footer-social is-unavailable" aria-label="Instagram"><Instagram size={16} /></span>}
      </div>
      <p>{t.contact.location}</p>
    </div>
  </div>

  <div class="container-shell footer-bottom">
    <span>© {new Date().getFullYear()} Mifer Digital</span>
    <div class="footer-links">
      <a data-nav-link data-prefetch-link href={locales[lang].workPath}>{t.nav.work}</a>
      <a data-nav-link data-prefetch-link data-lang-switch href={lang === 'tr' ? '/en' : '/tr'}>{locales[lang].switchLabel}</a>
      <button type="button" class="footer-cookie-link" data-cookie-settings>{lang === 'tr' ? 'Çerez ayarları' : 'Cookie settings'}</button>
    </div>
  </div>
</footer>
