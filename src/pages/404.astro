---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout
  lang="tr"
  title="Sayfa bulunamadı | Mifer Digital"
  description="Aradığınız sayfa bulunamadı. Mifer Digital ana sayfasına dönebilirsiniz."
  canonicalPath="/404"
  alternatePath="/en"
  noindex
>
  <Header lang="tr" alternatePath="/en" />
  <main class="not-found-page">
    <div class="container-shell not-found-shell">
      <p class="not-found-code">404</p>
      <h1>Bu sayfa burada değil.</h1>
      <p>Bağlantı değişmiş veya sayfa kaldırılmış olabilir. Ana sayfadan devam edebilirsiniz.</p>
      <a href="/" data-nav-link>ANA SAYFAYA DÖN <span aria-hidden="true">↗</span></a>
    </div>
  </main>
  <Footer lang="tr" />
</BaseLayout>
